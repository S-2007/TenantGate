# ---------------------------------------------------------------------------
# rag-platform configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Neon POOLED connection string for the running app (dev branch).
# Neon console -> your project -> branch "dev" -> Connect -> "Connection pooling" ON.
# The host contains "-pooler", e.g. ep-xxx-pooler.<region>.aws.neon.tech. Must end with ?sslmode=require
# Phase 2+: after `python -m scripts.create_app_role`, this holds the SELECT-only rag_app_login role
# (the script writes it). Start with the owner's pooled string only to bootstrap.
DATABASE_URL=<neon-dev-branch-pooled-connection-string>

# Neon DIRECT connection string (same branch, "Connection pooling" OFF; host has NO "-pooler").
# Used only by Alembic migrations and admin scripts.
DATABASE_URL_DIRECT=<neon-dev-branch-direct-connection-string>

# Pooled + direct strings for a NON-main Neon branch used by tests (e.g. create branch "test" from dev).
# Tests abort if this resolves to the default/production branch.
TEST_DATABASE_URL=<neon-test-branch-pooled-connection-string>
TEST_DATABASE_URL_DIRECT=<neon-test-branch-direct-connection-string>

# LLM provider: "groq" or "gemini" (free tiers) or "fake" (deterministic, no key, used by tests/CI).
LLM_PROVIDER=groq
# Groq model id for answers (free tier, Nov 2026). llama-3.x models were shut down on Groq
# 2026-08-16. Free-tier text models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b.
LLM_MODEL=openai/gpt-oss-120b
# Separate model for the eval judge: own rate-limit bucket + less self-grading bias.
# Leave empty to reuse LLM_MODEL.
JUDGE_MODEL=openai/gpt-oss-20b
# Free key: https://console.groq.com/keys (sign in -> Create API Key). Starts with "gsk_".
GROQ_API_KEY=<groq-api-key>
# Fallback chain, tried in order when the model above fails (rate limit, outage).
# Format: provider:model,provider:model  (providers: groq, gemini). Empty = no fallback.
# Entries whose provider key is empty are skipped (with a warning naming the variable).
LLM_FALLBACKS=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite
# Fallback chain for the eval judge (after JUDGE_MODEL).
JUDGE_FALLBACKS=gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b
# Free key: https://aistudio.google.com/apikey (sign in with a Google account -> Create API key).
# Optional: without it the gemini fallbacks are skipped. Free-tier content may be used by Google
# to improve its products, so never send real customer data through the free tier.
GEMINI_API_KEY=<gemini-api-key>

# HMAC secret for signing JWTs (>= 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generated-random-secret>
# JWT signing algorithm.
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes.
JWT_EXPIRE_MINUTES=15
# Expected "iss" claim.
JWT_ISSUER=rag-platform
# Expected "aud" claim.
JWT_AUDIENCE=rag-platform-api

# sentence-transformers model name ("hash" = deterministic offline test embedder).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the model output and the vector(...) column in migrations.
EMBEDDING_DIM=384
# Chunk size / overlap in embedding-model tokens.
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# Number of chunks retrieved per question.
TOP_K=5
# pgvector HNSW search: candidate list size and iterative scan (off|strict_order|relaxed_order).
# strict_order keeps returning top_k rows even when the ACL filter is very selective.
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN=strict_order
# App DB connection pool (per process). Raise for load tests.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
# Folder with the corpus and manifest.json.
CORPUS_PATH=data/corpus

# development | test | ci | production
ENV=development
# Audit log: true stores the question text; false stores only its keyed hash (HMAC-SHA256).
STORE_QUERY_TEXT=true

# Neon console -> Account settings -> API keys. Used by the test guard and CI branch creation.
NEON_API_KEY=<neon-api-key>
# Neon console -> Project settings -> General -> Project ID (e.g. "wispy-forest-12345678").
NEON_PROJECT_ID=<neon-project-id>
